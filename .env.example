# Copiá este archivo como .env.local y completá con los datos del proyecto de Supabase
# (Project Settings > API). La clave anon es pública: la seguridad está en las políticas RLS.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Ingreso: "email" (código por email, sirve para pruebas) o "sms" (requiere proveedor de SMS en Supabase)
EXPO_PUBLIC_LOGIN_METHOD=email

# ID de la credencial OAuth "Web" de Google Cloud (la misma que se carga en Supabase).
# Sin este dato no aparece el botón "Continuar con Google". Google no funciona en Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
